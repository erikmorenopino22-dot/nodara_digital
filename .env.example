# Copia este archivo como ".env" y rellena el valor para activar el formulario.
# Debe ser la URL de un servicio que acepte un POST con JSON
# (por ejemplo Formspree: https://formspree.io/f/tu-id).
# Mientras esté vacío, la web avisa de que el formulario no está conectado
# y NO simula ningún envío.
VITE_FORM_ENDPOINT=
